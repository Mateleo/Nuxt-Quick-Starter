{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [".nuxt", ".output", "dist", "node_modules"]
}
